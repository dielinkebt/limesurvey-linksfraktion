{{ registerTemplateCssFile('css/errors.css') }}
{{ registerTemplateCssFile('css/fonts.css') }}
{{ registerTemplateCssFile('css/linksfraktion.css') }}
{% set aError = aSurveyInfo.aError %}

<!DOCTYPE html>
<html lang="{{ aSurveyInfo.htmllanguagecode }}" dir="{{ aSurveyInfo.dir }}"
      class="{{ aSurveyInfo.languagecode }} dir-{{ aSurveyInfo.dir }} {{ aSurveyInfo.class.html }}" {{ aSurveyInfo.attr.html }}>

<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>
        {% if aError.error %}{{ aError.error }}{% else %}Error {{ aSurveyInfo.surveyls_title }}{% endif %}
    </title>
    <meta name="generator" content="LimeSurvey http://www.limesurvey.org"/>
    {% if(imageSrc('./files/favicon.ico')) %}
        <link rel="shortcut icon" href="{{ imageSrc('./files/favicon.ico') }}"/>
    {% endif %}
    {{ include('./subviews/header/custom_header.twig') }}
</head>

<body class="error-page {{ aSurveyInfo.class.body }} lang-{{ aSurveyInfo.languagecode }} {{ surveyformat }}" {{ aSurveyInfo.attr.body }}>
    <main class="lf-error" id="main">
        <div class="error-logo-container">
            <img class="logo" src="{{ imageSrc(aSurveyInfo.options.brandlogofile ?? './files/logo.svg') }}" alt="Die Linke im Bundestag">
        </div>

        <h1 class="error-title">
            {% if aError.error %}{{ aError.error }}{% endif %}
            {{ aError.title }}
        </h1>

        <div class="error-content">{{ aError.message }}</div>

        {% if aError.URL %}
            <div class="error-content">{{ aError.URL }}</div>
        {% endif %}

        <div class="error-content error-contact">
            {% if aError.contact %}
                {{ aError.contact }}
            {% else %}
                {{ gT("For further information please contact %s:")|format(aSurveyInfo.admin) }}
                {% if aSurveyInfo.adminemail %}
                    <br>
                    <a class="error-link" href="mailto:{{ aSurveyInfo.adminemail }}">{{ aSurveyInfo.adminemail }}</a>
                {% endif %}
            {% endif %}
        </div>

        {% if aError.trace is not empty %}
            <pre class="error-trace">{{ aError.trace }}</pre>
        {% endif %}
    </main>

    {% block footer %}
        {{ include('./subviews/footer/footer.twig') }}
    {% endblock %}
</body>
</html>
